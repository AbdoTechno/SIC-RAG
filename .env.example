# Required in production. The PostgreSQL server must have the pgvector extension.
RAG_DB_DSN=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
GROQ_API_KEY=replace-with-a-groq-api-key

# Strongly recommended for a public deployment.
RAG_API_KEY=replace-with-a-long-random-value

# BotKeep injects SERVER_PORT. The local fallback in start.py is 8000.
# SERVER_PORT=8000

# Comma-separated origins. Needed by Flutter Web; native Flutter is not subject to CORS.
RAG_CORS_ORIGINS=https://your-flutter-web-app.example

# Optional tuning.
RAG_DB_POOL_MAX=3
RAG_MAX_UPLOAD_MB=20
RAG_LLM_MODEL=allam-2-7b
RAG_LLM_TEMP=0.1
RAG_LLM_MAX_TOKENS=1024
RAG_ENFORCE_SCOPE=true
RAG_BOOTSTRAP_SEED=true

# For a single-instance prototype. This relative path is writable under the app directory.
# Confirm that BotKeep preserves it across redeployments before production ingestion.
# RAG_STORE_PROVIDER=sqlite_store
# RAG_DB_DSN=data/pulmora_rag.db
